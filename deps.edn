{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; Token verification and the scope model. Both are workspace git deps
        ;; and both are portable .cljc -- they run in the Worker, not beside it.
        io.github.kotoba-lang/org-biscuitsec
        {:git/url "https://github.com/kotoba-lang/org-biscuitsec.git"
         :git/sha "753201fc60f825bade581e87bcb5cee70cdb6398"}
        ;; The curve. org-biscuitsec injects sign/verify and deliberately does
        ;; not depend on an implementation, so the host supplies one.
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
         :git/sha "c0b11c5ffe25d42f29b3f6a3d2d2317331e75336"}}
 :aliases
 ;; The compiler is a build tool, so it lives in an alias rather than in
 ;; :deps -- the Worker ships biscuit and the curve, not shadow.
 {:build {:extra-deps {thheller/shadow-cljs {:mvn/version "3.4.6"}}
          :main-opts ["-m" "shadow.cljs.devtools.cli" "release" "worker"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
