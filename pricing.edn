;; The price book. DATA, not code -- the shape is ADR-2608110200's, taken from
;; cloud-itonami-isic-6311-identity/pricing.edn rather than invented.
;;
;; This file is the only place a number lives, so a price change is a one-file
;; edit and never a deploy of the thing people call.
;;
;; ## Nothing here is published
;;
;; `:plan/status :proposed` on every plan, and the gates below are not met.
;; Numbers exist so they can be argued with, not because anyone may be billed
;; from them.
;;
;; ## Dimensions match what is actually measured
;;
;; `hanmoto.usage` records exactly two things, and this file may only price
;; those:
;;
;;   :query  one register query answered. Load.
;;   :mac    monthly active caller, de-duplicated at write time on the hashed
;;           did:pkh of the payer. Customers.
;;
;; A dimension not in that list cannot be honoured -- pricing a number nobody
;; counts is what makes an invoice indefensible.

{:pricing/version 1
 :pricing/currency "USD"
 :pricing/updated "2026-08-31"
 :pricing/authority "ADR-2608110200"

 :pricing/plans
 [{:plan/id :open
   :plan/name "Open"
   :plan/status :proposed
   :plan/monthly-base 0
   :plan/included {:query 1000}
   :plan/overage {}
   ;; No overage on the open plan: past the included queries the answer is
   ;; "choose a plan", not a surprise invoice.
   :plan/hard-cap {:query 1000}
   :plan/features [:category-counts :host-lookup :software-distribution]
   :plan/support :community
   :plan/sla nil}

  {:plan/id :registry
   :plan/name "Registry"
   :plan/status :proposed
   :plan/monthly-base 25
   :plan/included {:query 100000 :mac 5}
   :plan/overage {:query 0.0002}
   :plan/hard-cap nil
   :plan/features [:category-counts :host-lookup :software-distribution
                   :bulk-export :provenance-split :unknown-tail]
   :plan/support :email
   :plan/sla nil}]

 ;; What must be true before anyone is charged. Answered from data rather than
 ;; from someone remembering.
 :pricing/gates
 [{:gate/id :meter-running
   :gate/met true
   ;; 2026-08-31: met. Deployed to hanmoto.itonami.cloud, three calls arrived,
   ;; and KV holds `count/query/unscoped/2026-08` = 3. The traffic was the
   ;; operator's own -- **stated rather than dressed up as demand** -- but the
   ;; mechanism is no longer a claim: a call produced a persisted record.
   :gate/note "Met. hanmoto.itonami.cloud serves the register and a call persists
               a usage record in KV (count/query/unscoped/2026-08 = 3 at first
               light). The traffic so far is the operator's own."}
  {:gate/id :principal-established
   :gate/met false
   ;; 2026-08-31, fourth pass. The blocker moved out of the library and into
   ;; operations, which is a better place for it to be.
   ;;
   ;; Previously this refused every token carrying a check, because
   ;; `biscuit.wire` counted checks and dropped them -- and every reference
   ;; token carries one, so that was the common case, not an edge. Both halves
   ;; are now upstream: wire decodes the checks this implementation can
   ;; evaluate, and `biscuit.authorizer/run-checks` runs them for a
   ;; wire-verified token.
   ;;
   ;; Measured against the deployment with the biscuit spec's own public test
   ;; key temporarily configured, then removed:
   ;;
   ;;   reference token       -> :biscuit/check-failed      the check RAN
   ;;   token under other key -> :biscuit/signature-mismatch verification still
   ;;                                                       discriminates
   ;;   garbage               -> :biscuit/malformed
   ;;   key removed           -> :biscuit/no-root-key-configured
   ;;
   ;; The refusal that remains is narrower and honest: a check carrying an
   ;; expression, a kind other than One, or a disjunction is still
   ;; :biscuit/checks-not-evaluated, because honouring one would mean ignoring
   ;; the limits a token places on itself.
   ;;
   ;; Still unmet, for one reason and it is no longer a library gap: **nothing
   ;; in this workspace mints a wire token**. `biscuit.wire` is decode-only and
   ;; the one issuer here (cloud-itonami-app-5090-stability) signs the model
   ;; payload, which is different bytes. So no root key is configured in
   ;; production, because there is no key whose tokens anyone could present.
   :gate/note "The caller half is established, and the scope half now has a
               verifier that decodes and RUNS a token's checks -- measured live
               on a reference token, which reaches :check-failed rather than
               being refused as unevaluable. Unmet because nothing here mints a
               wire token, so no root key is configured: there would be no
               token to present to it."}
  {:gate/id :register-refreshed-on-a-schedule
   :gate/met true
   ;; 2026-08-31: met, and the last step was the one that mattered.
   ;;
   ;; The register had no producer at all -- loaded by hand on 2026-08-09, it
   ;; could only age. Now `scripts/build-register.cljs` derives it from the
   ;; corpus and `scripts/refresh-register.cljs` runs daily from launchd
   ;; (`cloud.itonami.hanmoto-register`).
   ;;
   ;; **It has actually run.** A schedule that never fired and no schedule are
   ;; the same thing from outside, so this was not called met until launchd
   ;; published one end to end: exit 0, `:outcome :published`, and the live
   ;; answer carrying that run's own timestamp.
   ;;
   ;; Answers now carry two dates, because one cannot say this:
   ;;
   ;;   as-of      2026-08-09   when the DATA last changed
   ;;   checked-at 2026-08-31   when it was last re-derived
   ;;   age-days   22           measured from the data, not the rebuild
   ;;
   ;; Re-deriving reproduced the 2026-08-09 counts exactly -- 27,307 hosts,
   ;; 1,628 unclassified, every category identical. The register is old and not
   ;; wrong, and a rebuild does not shorten its age. Stamping `as-of` with the
   ;; run time would have made every stale snapshot look new.
   ;;
   ;; Two limits, named rather than left to be discovered:
   ;;
   ;; 1. It runs on the operator host, because it needs Cloudflare credentials
   ;;    and fleet nodes hold none. If that machine is off, nothing runs -- but
   ;;    ~/.gftd/hanmoto-register.edn is written on every run including ones
   ;;    that change nothing, so a job that stopped is visible.
   ;; 2. It does not advance the corpus pin. The corpus is a west project at a
   ;;    detached HEAD, and moving a pin is a governed action, so the job
   ;;    reports `:corpus-behind` and re-derives from what the pin says. A
   ;;    stale pin still means a stale register; it is just no longer silent.
   :gate/note "Met. build-register.cljs derives the register from the corpus and
               refresh-register.cljs publishes it daily from launchd; one run has
               gone end to end and the live answer carries its timestamp. Answers
               separate as-of (when the data changed) from checked-at (when it
               was last re-derived), so a rebuild cannot make a stale snapshot
               look new. Runs on the operator host, and reports rather than moves
               the corpus pin."}
  {:gate/id :catalog-entry
   :gate/met true
   :gate/note "Met. Registered at x402.nexus via POST /apply; the catalog lists
               three hanmoto rules and GET /gateway/hanmoto/x402/counts answers
               402 with a challenge naming this actor's payTo. There is a way to
               be paid."}
  {:gate/id :priced-resources-not-served-free
   :gate/met true
   ;; 2026-08-31, later the same day: met, and measured in both directions
   ;; against the deployment rather than read off the code.
   ;;
   ;;   no token          -> 402   the bypass, closed
   ;;   forged payer      -> 402   the spoofing surface, closed with it
   ;;   wrong token       -> 403   a rejected credential is not an absent one
   ;;   correct token     -> 200   the facilitator's own call still works
   ;;   /health           -> 200   free paths untouched
   ;;   an unsold path    -> 404   still not-for-sale, never 402
   ;;
   ;; Mechanism: nexus `proxy-to-origin` injects a shared secret when the seller
   ;; rule declares auth-header/auth-secret-env -- offered since murakumo, and
   ;; now declared on all three hanmoto rules in SELLERS_KV. `hanmoto.gateway`
   ;; requires it on priced paths and fails closed when the origin holds no
   ;; secret at all.
   ;;
   ;; **One link is still unmeasured, and it is named rather than assumed**: no
   ;; settled payment has travelled the whole path. The origin admitting the
   ;; correct token was measured here; nexus injecting it on a settled call is
   ;; read from its code and its rule, not observed. Closing that needs a real
   ;; 0.001 USDC purchase through the gateway, which is the operator's to make.
   :gate/note "Met. Priced paths refuse unless the request carries the secret
               nexus injects; measured 2026-08-31 as 402 without it, 403 with a
               wrong one, 200 with the right one, and free paths unchanged. Not
               yet observed: a settled payment traversing gateway to origin."}
  {:gate/id :terms-for-a-directory-service
   :gate/met false
   :gate/note "No terms written for redistributing a host directory, including
               what a buyer may do with it."}
  {:gate/id :unknown-tail-disclosed-in-product
   :gate/met true
   ;; 2026-08-31: met, and it was met before it was recorded -- the live
   ;; /x402/counts returns "unknown":1628 and "unknown_ratio":0.059618 beside the
   ;; category counts, because `census/by-category` has always returned them
   ;; together and `serve` never had a path that dropped them.
   ;;
   ;; Left unmet in the ledger for a while after it was true, which is the same
   ;; class as a gate describing a solved problem: a book that lags the thing it
   ;; describes stops being read.
   :gate/note "Met. Every categorical answer carries :unknown and
               :unknown_ratio -- live /x402/counts returns 1628 and 0.059618
               beside the counts. The unclassified tail is a product field, not
               a README footnote."}]

 :pricing/disclosures
 ["The register holds hosts, never accounts. Answering how many must not require
   the ability to answer who."
  "self-reported and observed provenance are never summed into one number."
  "Scale figures (users, posts) are the host's own declaration and are not
   verified."]}
