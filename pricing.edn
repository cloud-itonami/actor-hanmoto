;; The price book. DATA, not code -- the shape is ADR-2608110200's, taken from
;; cloud-itonami-isic-6311-identity/pricing.edn rather than invented.
;;
;; This file is the only place a number lives, so a price change is a one-file
;; edit and never a deploy of the thing people call.
;;
;; ## Nothing here is published
;;
;; `:plan/status :proposed` on every plan, and the gates below are not met.
;; Numbers exist so they can be argued with, not because anyone may be billed
;; from them.
;;
;; ## Dimensions match what is actually measured
;;
;; `hanmoto.usage` records exactly two things, and this file may only price
;; those:
;;
;;   :query  one register query answered. Load.
;;   :mac    monthly active caller, de-duplicated at write time on the hashed
;;           did:pkh of the payer. Customers.
;;
;; A dimension not in that list cannot be honoured -- pricing a number nobody
;; counts is what makes an invoice indefensible.

{:pricing/version 1
 :pricing/currency "USD"
 :pricing/updated "2026-08-31"
 :pricing/authority "ADR-2608110200"

 :pricing/plans
 [{:plan/id :open
   :plan/name "Open"
   :plan/status :proposed
   :plan/monthly-base 0
   :plan/included {:query 1000}
   :plan/overage {}
   ;; No overage on the open plan: past the included queries the answer is
   ;; "choose a plan", not a surprise invoice.
   :plan/hard-cap {:query 1000}
   :plan/features [:category-counts :host-lookup :software-distribution]
   :plan/support :community
   :plan/sla nil}

  {:plan/id :registry
   :plan/name "Registry"
   :plan/status :proposed
   :plan/monthly-base 25
   :plan/included {:query 100000 :mac 5}
   :plan/overage {:query 0.0002}
   :plan/hard-cap nil
   :plan/features [:category-counts :host-lookup :software-distribution
                   :bulk-export :provenance-split :unknown-tail]
   :plan/support :email
   :plan/sla nil}]

 ;; What must be true before anyone is charged. Answered from data rather than
 ;; from someone remembering.
 :pricing/gates
 [{:gate/id :meter-running
   :gate/met false
   ;; 2026-08-31: narrowed, not closed. The host seam now exists --
   ;; `hanmoto.serve/handle` returns the response and the usage it incurred in
   ;; one value, so an answer that was served and not counted is not
   ;; expressible, and the meter has been run end to end (2 callers over 2
   ;; months, de-duplicated at the key, folded by `usage/report`, asserted).
   ;;
   ;; What remains false is narrower and still decisive.
   :gate/note "The host seam exists and is exercised: hanmoto.serve returns usage
               with every answer, and hanmoto.serve-test runs the meter end to
               end. Still unmet because nothing is deployed, no caller has
               arrived, and no store persists a record -- a meter exercised in a
               test has not measured a month."}
  {:gate/id :register-refreshed-on-a-schedule
   :gate/met false
   ;; 2026-08-31: narrowed. Every answer now carries the register's as-of, its
   ;; source and its age in days (`hanmoto.register/provenance`), and rows
   ;; without provenance are refused at load. So a buyer can no longer be sold a
   ;; snapshot as current -- which was the sharper half of this gate, because an
   ;; answer built from a stale register looked exactly like one built from a
   ;; live register.
   ;;
   ;; Still unmet: nothing refreshes it.
   :gate/note "Answers carry as-of, source and age-days, and undated rows are
               refused at load -- a snapshot can no longer pass as current. Still
               unmet because nothing refreshes the register: it remains the
               2026-08-09 upstream snapshot, and selling a directory implies
               keeping it current."}
  {:gate/id :catalog-entry
   :gate/met false
   :gate/note "No x402 SKU names this actor, so there is no way to be paid.
               See scripts/itonami-actor-pnl.cljs."}
  {:gate/id :terms-for-a-directory-service
   :gate/met false
   :gate/note "No terms written for redistributing a host directory, including
               what a buyer may do with it."}
  {:gate/id :unknown-tail-disclosed-in-product
   :gate/met false
   :gate/note "6.0% of hosts are outside the category vocabulary. The API must
               return that number with every categorical answer, not just the
               README."}]

 :pricing/disclosures
 ["The register holds hosts, never accounts. Answering how many must not require
   the ability to answer who."
  "self-reported and observed provenance are never summed into one number."
  "Scale figures (users, posts) are the host's own declaration and are not
   verified."]}
